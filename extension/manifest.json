{
  "manifest_version": 2,
  "name": "PTB Reload",
  "version": "1.1.1",
  "description": "Lädt den aktuellen Tab zu einem exakten Zeitpunkt nach PTB-Atomuhrzeit neu.",
  "author": "Lukas Runge",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ptb-reload@lukas-runge.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "permissions": ["tabs", "<all_urls>"],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "browser_action": {
    "default_title": "PTB Reload",
    "default_icon": "icons/icon.svg",
    "default_popup": "popup.html"
  }
}
